# All optional. With nothing set, docparse runs fully local: pdfplumber text layer + Tesseract OCR.
DOCPARSE_OCR_MODE=auto            # auto | never | force
DOCPARSE_TESSERACT_LANGS=eng+fra
DOCPARSE_MISTRAL_API_KEY=         # enables Mistral OCR for scanned PDFs
DOCPARSE_OPENAI_API_KEY=          # enables figure/table description with a vision model
DOCPARSE_OPENAI_MODEL=gpt-4o-mini
DOCPARSE_OCR_WORKER_URL=          # http://localhost:8001 → EasyOCR worker (workers/easyocr)
DOCPARSE_LAYOUT_WORKER_URL=       # http://localhost:8002 → TF-ID layout worker (workers/tfid)
DOCPARSE_RUNPOD_API_KEY=          # with the two endpoint ids below, workers run on RunPod serverless
DOCPARSE_RUNPOD_OCR_ENDPOINT=
DOCPARSE_RUNPOD_LAYOUT_ENDPOINT=
DOCPARSE_API_KEY=                 # if set, the HTTP API requires X-API-Key
